{
  "expo": {
    "name": "Persei",
    "slug": "persei",
    "version": "0.9.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "persei",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "bundleIdentifier": "com.mateobaril.persei",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Persei utilise l'appareil photo pour capturer vos photos avec des réglages manuels.",
        "NSMicrophoneUsageDescription": "Persei enregistre le son avec vos vidéos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "M9GRJSY2QN"
    },
    "android": {
      "package": "com.mateobaril.persei",
      "adaptiveIcon": {
        "backgroundColor": "#0b0d12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0d12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Persei enregistre vos photos dans votre photothèque."
        }
      ],
      "./plugins/with-app-intents"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "635b511a-3730-4382-a477-bf9e1671017e"
      }
    },
    "owner": "matal",
    "updates": {
      "url": "https://u.expo.dev/635b511a-3730-4382-a477-bf9e1671017e"
    }
  }
}
